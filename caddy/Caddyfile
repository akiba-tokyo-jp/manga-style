mail.akiba.tokyo.jp {
	# ★ 2026-10-21 緊急遮断: PHP の未認証 RCE（CVE-2026-109618 / CVE-2026-109619）。
	#   mailcow の Web は php-fpm 8.2.29（修正版 8.2.35 未満）で動き、/ も /admin も API も
	#   Autodiscover も PHP を通るため、Web 全体を外から閉じる（アプリより前に攻撃が届く）。
	#   メールの送受信（SMTP / IMAP / POP3 / Sieve）は Caddy を通らないので影響しない。
	#   ★ 解除はオーナーの指示があってから。mailcow の phpfpm を修正版にしたことを
	#   確かめたうえで、下の @acme / handle を元の reverse_proxy だけに戻す。
	# 証明書の HTTP-01 だけは通す（mailcow nginx の静的配信で PHP を通らない）。
	@acme path /.well-known/acme-challenge/*
	handle @acme {
		reverse_proxy https://mailcowdockerized-nginx-mailcow-1:8443 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}
	handle {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-store"
		header X-Robots-Tag "noindex, nofollow"
		respond "mailcow の Web 画面はセキュリティ対応のため一時停止しています。メールの送受信は通常どおり使えます。" 503
	}
}

akiba.tokyo.jp {
	tls /etc/letsencrypt/live/akiba.tokyo.jp/fullchain.pem /etc/letsencrypt/live/akiba.tokyo.jp/privkey.pem

	# 静的ページの配信元
	root * /srv/top

	# トップ（/）へのアクセスで、自作ページ（/srv/top/index.html）が
	# 「実在するときだけ」自作ページを配信する。
	# 未配置なら @home は不成立となり、下の PDS へフォールバックする
	# （＝ファイルが無くても 404 にせず、今まで通り PDS を出す）。
	@home {
		path /
		file {
			try_files /index.html
		}
	}
	handle @home {
		file_server
	}

	# 音楽室は www 側に一本化した（訪問者が来るトップが www で、ページは inviteapp が
	# この町のデザインで描くため）。apex に来たぶんは www へ送る。
	# PDS が使うパス（/xrpc, /.well-known, /oauth）とは衝突しないので、PDS への
	# フォールバックより先に置いてよい。
	# {uri} には /music/... がそのまま入っているので、行き先に /music を書き足さないこと
	#（書くと https://www.akiba.tokyo.jp/music/music/... と二重になる。実測で確認）。
	redir /music* https://www.akiba.tokyo.jp{uri} permanent

	# ゲームセンターも www 側に置く（ページは inviteapp が描く）。apex に来たぶんは www へ。
	# {uri} には /game がそのまま入っているので、行き先に /game を書き足さないこと。
	redir /game* https://www.akiba.tokyo.jp{uri} permanent

	# 本屋さんは 2026-08-14 に cost-lab.jp へ移した。apex に来たぶんも同じ行き先へ。
	redir /books* https://cost-lab.jp{uri} permanent

	# それ以外（/xrpc, /.well-known, /oauth など PDS が使う全パス）
	# および 自作ページ未配置時の / も、今まで通り PDS へ
	handle {
		reverse_proxy pds:3000
	}
}

# MATERIAL: activate only after the material delivery PR has completed.
# Reuses the existing wildcard certificate and /var/www -> /srv mount.
material.akiba.tokyo.jp {
	tls /etc/letsencrypt/live/akiba.tokyo.jp/fullchain.pem /etc/letsencrypt/live/akiba.tokyo.jp/privkey.pem
	root * /srv/material
	header X-Content-Type-Options nosniff
	header Cache-Control "public, max-age=300, must-revalidate"
	encode zstd gzip
	file_server
}

*.akiba.tokyo.jp {
	tls /etc/letsencrypt/live/akiba.tokyo.jp/fullchain.pem /etc/letsencrypt/live/akiba.tokyo.jp/privkey.pem

	# 住民サブドメイン（例 denko.akiba.tokyo.jp）のトップ（/）だけ自作ページを配信する。
	# 配信元は /srv/handles。ハンドル名は {http.request.host.labels.3}
	#（jp=0 / tokyo=1 / akiba=2 / <handle>=3）。単一ラベルなのでパストラバーサル不可。
	root * /srv/handles

	# 専用ページ（/srv/handles/<handle>/index.html）があればそれを配信（例: denko）
	@custom {
		path /
		file {
			try_files /{http.request.host.labels.3}/index.html
		}
	}
	handle @custom {
		try_files /{http.request.host.labels.3}/index.html
		file_server
	}

	# 専用ページが無ければ、住民共通ページ（/srv/handles/index.html）を配信。
	# この1枚を全住民で共有するので、新しい住民が増えても自動で共通ページになる。
	@common {
		path /
		file {
			try_files /index.html
		}
	}
	handle @common {
		try_files /index.html
		file_server
	}

	# それ以外（/.well-known/atproto-did, /xrpc, /oauth など）は今まで通り PDS へ。
	# ファイル未配置時の / も、ここで PDS にフォールバックする（404 にしない）。
	handle {
		reverse_proxy pds:3000
	}
}

www.akiba.tokyo.jp {
	tls /etc/letsencrypt/live/akiba.tokyo.jp/fullchain.pem /etc/letsencrypt/live/akiba.tokyo.jp/privkey.pem

	# 音楽室の**楽譜と MusicXML の実ファイル**だけをここで直接配る（1曲300KB以上あり、
	# アプリを通す意味がないため）。**ページ本体は inviteapp が描く**ので、下の
	# reverse_proxy に任せる＝この町のデザイン（6テーマ・ウィンドウ枠）にそろう。
	# ★ 配信元は /opt/akiba-uta/out ではなく public。out には未公開の候補と品質チェック
	#   不合格の回が混ざっており、ディレクトリ名は日時なので推測もできる。
	# reverse_proxy より先に置くこと（後ろに置くと全部 inviteapp に吸われる）。
	handle_path /music/songs/* {
		root * /srv-uta
		file_server
		encode gzip
		# 楽譜は差し替わらないが songs.json は増えるので、短めにして再検証させる。
		header Cache-Control "public, max-age=600, must-revalidate"
	}

	# 本屋さんは 2026-08-14 に cost-lab.jp へ移した。
	# ナビからも外したが、古い URL・検索結果が 404 にならないよう転送だけ残す。
	# {uri} には /books?... がそのまま入るので、行き先に /books を書き足さないこと。
	redir /books* https://cost-lab.jp{uri} permanent

	handle {
		reverse_proxy inviteapp:8000
	}
}

# Struharmonia Web MMO。旧 struwaltz サーバとは別コンテナ・別データ。
# TLS は既存証明書を利用。/auth と /ws を含め同一オリジンで配る。
game.akiba.tokyo.jp {
	tls /etc/letsencrypt/live/akiba.tokyo.jp/fullchain.pem /etc/letsencrypt/live/akiba.tokyo.jp/privkey.pem

	# /kanban 閲覧サービス（docs/kanban/CONTRACT.md §1/§4, OPERATIONS.md）。
	# ★ 動的 API/ingest だけを costlab-auth compose の kanban-viewer（web network 内 8081、
	#   ホスト port 公開なし）へ。静的 shell（sites/game/public/kanban/）は game deploy の
	#   struharmonia-web が配る。この順（API/ingest → /kanban 静的 → 通常 game）を崩さない。
	# ★ 秘密・ボード内容はここに書かない。header だけを最終応答で上書きする。
	# ★ 検査: tests/kanban_delivery/test_outer_caddy.py（実 Caddy + 実 game/Caddyfile）。
	@kanban_dynamic path /kanban/api /kanban/api/* /kanban/ingest /kanban/ingest/*
	handle @kanban_dynamic {
		# app 側も同じ header を付ける契約。502/503 等でも欠けないよう外側でも固定する。
		header {
			defer
			Cache-Control "private, no-store"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			X-Robots-Tag "noindex, nofollow"
		}
		# snapshot は最大 8MiB の JSON（非表示タブも1分ごとに取得）。対応ブラウザには圧縮して返す。
		# 512 bytes 未満（ingest の受理応答等）と添付の octet-stream は既定どおり圧縮されない。
		# 要求 body は伸張しない（ingest の署名 digest は送られた bytes のまま）。秘密は応答に含まれない。
		encode zstd gzip
		reverse_proxy kanban-viewer:8081
	}

	# /kanban → /kanban/（308）。Cookie Path=/kanban/ と相対 URL を一致させる。
	handle /kanban {
		header {
			Cache-Control "private, no-store"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			X-Robots-Tag "noindex, nofollow"
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		}
		# ★ `*` を省くと /kanban/ が matcher と解釈され、redir が効かない（harness で確認）。
		redir * /kanban/ 308
	}

	# 静的 shell。上流 game/Caddyfile の `public, max-age=0, must-revalidate` /
	# `Referrer-Policy same-origin` を **defer で最終応答に上書き**する（事前付与では負ける）。
	handle /kanban/* {
		header {
			defer
			Cache-Control "private, no-store"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			X-Robots-Tag "noindex, nofollow"
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
			-Last-Modified
			-ETag
		}
		reverse_proxy struharmonia-web:8080
	}

	# 通常の game（従来どおり。header は上流のまま）。
	handle {
		reverse_proxy struharmonia-web:8080
	}

	# 上流停止（502 等）は通常の handle の header を通らない。/kanban 配下だけ
	# 同じ4 header を付ける。通常 game のエラー応答は従来どおり（空 body＋status）。
	handle_errors {
		@kanban_error path /kanban /kanban/*
		header @kanban_error {
			Cache-Control "private, no-store"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			X-Robots-Tag "noindex, nofollow"
		}
	}
}

# STRUWALTZ ゲームサーバ（コンテナ struwaltz、compose は akiba-tokyo-jp/struwaltz）。
# ワイルドカード *.akiba.tokyo.jp より前に置く。DNS は既存のワイルドカード A。
# WebSocket /ws は reverse_proxy が Upgrade する。
struwaltz.akiba.tokyo.jp {
	tls /etc/letsencrypt/live/akiba.tokyo.jp/fullchain.pem /etc/letsencrypt/live/akiba.tokyo.jp/privkey.pem
	encode gzip
	reverse_proxy struwaltz:5080
}

# STRUWALTZ の 3D 確認用ビューア（非公開）。ゲーム資産なので公開ディレクトリに出さない。
# DNS は既存の *.akiba.tokyo.jp ワイルドカード。tls も同じ証明書。
# ★ struwaltz.akiba.tokyo.jp（ゲームサーバ）とは別ホスト。上の reverse_proxy は触らない。
# ★ 認証は costlab-auth。/__auth/* を守るとログイン不能になる（2026-08-01 に踏んだ）。
preview.akiba.tokyo.jp {
	tls /etc/letsencrypt/live/akiba.tokyo.jp/fullchain.pem /etc/letsencrypt/live/akiba.tokyo.jp/privkey.pem

	handle /__auth/* {
		reverse_proxy costlab-auth:8000
	}

	# ★ マッチャで /__auth/* を必ず除外すること。forward_auth は handle より先に走る。
	@needs_auth not path /__auth/*
	forward_auth @needs_auth costlab-auth:8000 {
		uri /__auth/verify
		copy_headers Cookie
	}

	header X-Robots-Tag "noindex, nofollow, noarchive"
	header Cache-Control "private, no-store"

	root * /srv/struwaltz-preview
	file_server
	encode gzip
}

# マンガの絵柄カタログ（Genko Studio 向け。コンテナ manga-style、compose は costlab-auth/docker-compose.yml、
# ソースは costlab-auth/manga、手順は docs/manga-style.md）。
# 公開ページ・見本の画像・/v1/（Genko が読む API）は誰でも読める。**/admin だけ** costlab-auth のログイン。
# DNS は既存の *.akiba.tokyo.jp ワイルドカード。tls も同じ証明書。完全一致なので住民サブドメイン（→ PDS）より優先される。
# ★ /__auth/* を守るとログイン不能になる（2026-08-01 に踏んだ）。forward_auth は /admin の下だけに掛ける。
# ★ app 側も /admin で costlab-auth に同じ確認をもう一度する（ここが外れても開かない）。
# ★ /internal/* はコンテナ内の操作用（docker exec の CLI）。外からは 404。
manga.akiba.tokyo.jp {
	tls /etc/letsencrypt/live/akiba.tokyo.jp/fullchain.pem /etc/letsencrypt/live/akiba.tokyo.jp/privkey.pem
	encode gzip

	handle /__auth/* {
		reverse_proxy costlab-auth:8000
	}

	# ★ copy_headers Cookie は書かない。Caddy 2.11 以降は、認証の応答に Cookie が無いとき（204 には無い）
	#   元のリクエストの Cookie を消して app へ渡すため、app 側のログイン再確認が必ず失敗する
	#   （2026-09-26、ログインしても {"error":"forbidden"} になった）。書かなくても Cookie は
	#   costlab-auth へも app へも元のまま届く。検査: costlab-auth/manga/tests/caddy_routing.py（本番と同じ caddy:latest）。
	@admin path /admin /admin/*
	forward_auth @admin costlab-auth:8000 {
		uri /__auth/verify
	}

	@internal path /internal /internal/*
	respond @internal 404

	reverse_proxy manga-style:8080
}

# お試し場（sandbox1 / sandbox2 / sandbox3）。
# 2026-09-03 に sandbox → sandbox1 へ改名し、同日 sys-you.jp から cost-lab.jp へ移設。
# 別ドメイン(cost-lab.jp)なので tls 行なし＝自動HTTPS。
# 配信元は /srv/sandbox1 など（sites/sandbox1 のデプロイ先）。compose のマウント追加は不要。
#
# ★ **中身は cost-lab.jp 本体（keiba / stock）とも無関係**。
#   ホストを間借りしているだけで、世界観も配色も共有しない
#   （docs/sandbox.md の「あきば町の世界観から切り離す」と同じ扱い）。
# ★ cost-lab.jp と違い **検索避けもログインも掛けない**（お試しの公開ページなので）。
# ★ DNS は 2026-08-01 の *.cost-lab.jp ワイルドカードで既に解決するため、レコード追加は不要。
sandbox1.cost-lab.jp {
	root * /srv/sandbox1
	file_server
	encode gzip
}

sandbox2.cost-lab.jp {
	root * /srv/sandbox2
	file_server
	encode gzip
}

sandbox3.cost-lab.jp {
	root * /srv/sandbox3
	file_server
	encode gzip
}

# 旧ホスト。**リンクを切らないための転送だけ**残す。
# ※ sandbox*.sys-you.jp は移設前の公開 URL。DNS は *.sys-you.jp のワイルドカードで
#   まだ VPS に向いているので、ブロックごと消すと証明書を発行できず TLS のエラーになる。
# ※ sandbox.cost-lab.jp は番号なしの旧名。正は sandbox1.cost-lab.jp。
sandbox1.sys-you.jp {
