}

# WEB Proxy（cost-lab.jp 配下・**非公開**）。
#
# ★ **公開領域には出さない。** cost-lab.jp のトップ・サイトマップからリンクを張らないこと。
# ★ 認証はアプリ自身（初期 ID/パスワードはサイト内の設定から変更する）。
#   keiba / stock の costlab-auth とは別。資格情報を混ぜない。
# ★ DNS は *.cost-lab.jp のワイルドカードで解決する。
# ★ 配信は webproxy コンテナ（costlab-auth の compose で一緒に上がる。
#   別プロセスなので、ここが落ちても keiba/stock のログインは生きる）。
proxy.cost-lab.jp {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	header Cache-Control "private, no-store"
	reverse_proxy webproxy:8000
}

# 株式クロスセクショナル分析のダッシュボード（cost-lab.jp 配下・**非公開**）。
#
# ★ **公開領域には一切出さない。** 特定銘柄の売買推奨を第三者に提供する行為は
#   投資助言業（金融商品取引業）の登録を要する。この画面は個人が自分の記録を見るためのもので、
#   cost-lab.jp のトップ・サイトマップからリンクを張らないこと。
# ★ 認証は **akiba.tokyo.jp（inviteapp の ADMIN_USER / ADMIN_PASS）と同じ ID・パスワード**。
#   ただし Caddy には平文ではなく **bcrypt ハッシュ**を置く（`caddy hash-password` で作る）。
#   実体は VPS の /opt/caddy/.env（リポジトリには置かない）。
#   ⚠ パスワードを変えるときは **inviteapp の .env と /opt/caddy/.env の2か所**を直す。
# ⚠ DNS は **レコードの追加が要る**。当初「*.cost-lab.jp のワイルドカードで解決する」と
#   書いていたが誤りで、ワイルドカードがあるのは sys-you.jp のほうだった
#   （sandbox.cost-lab.jp が個別レコードで引けていたため取り違えた）。
#   2026-08-01 に *.cost-lab.jp の CNAME を追加して解決した。
#   **新しいサブドメインを足すときは caddy-deploy の前に `dig +short <名前>` で確認する。**
# ★ 配信元は /opt/akiba-stock/public を :ro でマウントしたもの。
#   **SQLite 本体（/opt/akiba-stock/data）はマウントしない**——認証を1か所間違えただけで
#   全履歴が流出するため、公開物とデータを物理的に分けてある。
stock.cost-lab.jp {
	# ★ 2026-08-01、basic_auth をやめて costlab-auth（ログイン画面 ＋ Cookie ＋ パスキー）に
	#   統合した。keiba と**同じ認証サービス・同じ ID・同じパスキー**を使う。
	#   ⚠ **basic_auth はホーム画面の Web アプリ（standalone）と相性が悪い。**
	#     401 の本文は空で、standalone では認証ダイアログが出ないことがあるため、
	#     **画面が真っ白になって何もできない**（keiba 側が実機で踏んだ）。
	#     stock も直前にホーム画面対応を入れたので、同じ問題を踏む手前だった。
	#   ★ さらに**標準の認証ダイアログは iCloud キーチェーンの自動入力に対応しない**ため、
	#     basic_auth のままでは Face ID が使えない。ログイン画面なら使える。
	#   ★ costlab-auth は RP_ID=cost-lab.jp・Cookie ドメイン=.cost-lab.jp なので、
	#     **keiba で登録したパスキーがそのまま stock でも通り、一度のログインで両方見られる**。
	#
	# 認証サービス自身は認証の外に置く（ここを守ると誰もログインできない）。
	handle /__auth/* {
		reverse_proxy costlab-auth:8000
	}

	# それ以外は Cookie を検査してから通す。
	# ★ **マッチャで /__auth/* を必ず除外すること。**
	#   Caddy はディレクティブを**書いた順ではなく内蔵の優先順**で評価し、
	#   `forward_auth` は `handle` より**先**に走る。上の `handle /__auth/*` で
	#   認証の外に出したつもりでも、マッチャが無いと**ログイン画面まで守られて
	#   しまい、誰もログインできなくなる**（keiba 側が 2026-08-01 に実際に踏んだ。
	#   stock も同じ書き方をしていて、CI の検査に止めてもらった）。
	@needs_auth not path /__auth/*
	# ★ forward_auth は**中身を渡さない**。costlab-auth はヘッダだけ見て
	#   204（通す）か 303（ログイン画面へ）を返す。
	#   2xx 以外は**認証サーバの応答がそのまま client に返る**ので、
	#   リダイレクトは costlab-auth 側で組み立てている（Caddy 側では作れない）。
	forward_auth @needs_auth costlab-auth:8000 {
		uri /__auth/verify
		copy_headers Cookie
	}

	# robots.txt を読まないクローラにも効かせる。実効の要は上の認証だが、
	# 認証を外した瞬間に無防備にならないよう二重にする。
	header X-Robots-Tag "noindex, nofollow, noarchive"
	# 個人の記録なので、共有キャッシュにも中間装置にも残さない。
	header Cache-Control "private, no-store"

	root * /srv-stock
	file_server
	encode gzip
}

# 競馬モデルの検証結果と予測（cost-lab.jp 配下・**非公開**）。
#
# ★ **公開領域には出さない。** 当初は cost-lab.jp/keiba/ で公開していたが、
#   認証を掛ける方針になったので公開ハンドルは撤去してこちらへ移した
#   （認証を足しても、同じ中身が公開のまま残っていては意味がない）。
#   cost-lab.jp のトップ・サイトマップからリンクを張らないこと。
# ★ 認証は **costlab-auth**（ログイン画面 ＋ 署名付き Cookie ＋ パスキー）。
#   ID・パスワードは あきば町（inviteapp の ADMIN_USER / ADMIN_PASS）と同じものを
#   costlab-auth の .env に置く。**Caddy 側には資格情報を持たせない**。
#   ⚠ 2026-08-01 に basic_auth から移行した。理由は下のブロック内のコメント。
# ★ DNS は 2026-08-01 に足した *.cost-lab.jp のワイルドカードで解決する。
#   ⚠ それ以前は cost-lab.jp にワイルドカードが無く、stock を出すときに踏んだ。
#   **caddy-deploy の前に `dig +short keiba.cost-lab.jp` で引けることを確かめる**
#   （引けないまま reload すると ACME が失敗して証明書が取れない）。
# ★ 配信元は静的な器（/var/www/keiba）と、学習 cron が書く JSON（/opt/akiba-shared）だけ。
#   **SQLite 本体（/opt/keiba/data）はマウントしない**——認証を1か所間違えただけで
#   全データが流出するため、公開物とデータを物理的に分けてある（stock と同じ考え方）。
keiba.cost-lab.jp {
	# ★ 2026-08-01、basic_auth をやめて costlab-auth（ログイン画面 ＋ Cookie）にした。
	#   ⚠ **basic_auth はホーム画面の Web アプリ（standalone）と相性が悪い。**
	#     401 の本文は空で、standalone では認証ダイアログが出ないことがあるため、
	#     **画面が真っ白になって何もできない**（実機で踏んだ）。
	#     ログイン画面なら 401 でも必ず何かが出るし、パスキー（Face ID）も使える。
	#
	# 認証サービス自身は認証の外に置く（ここを守ると誰もログインできない）。
	handle /__auth/* {
		reverse_proxy costlab-auth:8000
	}

	# それ以外は Cookie を検査してから通す。
	# ★ **マッチャで /__auth/* を必ず除外すること。**
	#   Caddy はディレクティブを**書いた順ではなく内蔵の優先順**で評価し、
	#   `forward_auth` は `handle` より**先**に走る。上の `handle /__auth/*` で
	#   認証の外に出したつもりでも、マッチャが無いと**ログイン画面まで守られて
	#   しまい、誰もログインできなくなる**（2026-08-01 に実際に踏んだ）。
	@needs_auth not path /__auth/*
	# ★ forward_auth は**中身を渡さない**。costlab-auth はヘッダだけ見て
	#   204（通す）か 303（ログイン画面へ）を返す。
	#   2xx 以外は**認証サーバの応答がそのまま client に返る**ので、
	#   リダイレクトは costlab-auth 側で組み立てている（Caddy 側では作れない）。
	forward_auth @needs_auth costlab-auth:8000 {
		uri /__auth/verify
		copy_headers Cookie
	}

	# robots.txt を読まないクローラにも効かせる。実効の要は上の認証だが、
	# 認証を外した瞬間に無防備にならないよう二重にする。
	header X-Robots-Tag "noindex, nofollow, noarchive"
	# 個人の記録なので、共有キャッシュにも中間装置にも残さない。
	header Cache-Control "private, no-store"

	# ★ 並び順が意味を持つ。JSON の handle を静的配信より**前**に置くこと。
	#   handle は書いた順に評価され、先に一致したものだけが処理する。逆にすると
	#   JSON が静的ファイルとして探されて 404 になる（画面が永久に空になる）。
	@results path /data.json
	handle @results {
		root * /srv-shared
		rewrite * /keiba_results.json
		file_server
	}
	@predictions path /predictions.json
	handle @predictions {
		root * /srv-shared
		rewrite * /keiba_predictions.json
		file_server
	}
	# 日次の状態だけを明示配信。台帳や共有ディレクトリ全体は配信しない。
	@prediction_status path /prediction-status.json
	handle @prediction_status {
		root * /srv-shared
		rewrite * /keiba_prediction_status.json
		file_server
	}
	# 内容hashで固定した表示chunkだけを許可する。私有cache/manifest/tempは配信しない。
	handle /race-view/* {
		@race_view_archive_data path_regexp archive_data ^/race-view/archive/data/([0-9a-f]{64})[.]json$
		handle @race_view_archive_data {
			root * /srv-shared/keiba-archive
			rewrite * /{re.archive_data.1}.json
			file_server
		}
		@race_view_archive path_regexp archive ^/race-view/archive/(catalog|[0-9a-f]{64})[.]json$
		handle @race_view_archive {
			root * /srv-shared/keiba-race-view/outcome/archive
			rewrite * /{re.archive.1}.json
			file_server
		}
		@race_view_chunk path_regexp race_view ^/race-view/(forecast|outcome)/([0-9]{4}-[0-9]{2}-[0-9]{2})/([0-9a-f]{64})[.]json$
		handle @race_view_chunk {
			root * /srv-shared/keiba-race-view
			rewrite * /{re.race_view.1}/{re.race_view.2}/{re.race_view.3}.json
			file_server
		}
		handle {
			respond 404
		}
	}

	# 精算の派生状態のみ。元判断・生データ・私有台帳は公開しない。
	@settlement_status path /settlement-status.json
	handle @settlement_status {
		root * /srv-shared
		rewrite * /keiba_settlement_status.json
		file_server
	}

	handle {
		root * /srv/keiba
		file_server
	}

	encode gzip
}

# コストラボ（別ブランド・別ドメイン）。apex と www を同じ静的サイトへ。
# このドメインは akiba.tokyo.jp の証明書とは別なので、tls 行を書かず Caddy の自動HTTPS(ACME)に任せる
# （冒頭の email 設定で Let's Encrypt を自動発行。DNS を VPS の IP に向けておくこと）。
#
# ★ 2026-08-16、「商品まとめサイト」から「データ解析プロジェクトの公開面（ポータル）」へ転換した。
#   商品データの JSON 配信（/data.json・/curated/* 等）と発掘記事（/pick/*）はここから撤去済み。
#   経緯は docs/notes.md 2026-08-16。keiba.cost-lab.jp / stock.cost-lab.jp（非公開・下のブロック）は無関係。
cost-lab.jp, www.cost-lab.jp {
	encode gzip

	# 共通認証 costlab-auth（keiba/stock と同じサービス）。
	# Cookie は .cost-lab.jp に付き、apex でのパスキー登録（COSTLAB_ORIGINS）にも使う。
	# /fig/ が保護領域。認証サービス自身の結線は変えない。
	# 認証サービス自身（/__auth/*）は認証の外に置く（ここを守ると誰もログインできない）。
	handle /__auth/* {
		reverse_proxy costlab-auth:8000
	}
	# /fig/ はフィギュア AR（私的利用）。公開ポータルのトップ・サイトマップからリンクしない。
	# ★ forward_auth は handle より先に走るので、マッチャで /fig に限定する。
	#   マッチャ無しだと apex 全体が守られ、公開面までログイン必須になる。
	@fig path /fig /fig/*
	forward_auth @fig costlab-auth:8000 {
		uri /__auth/verify
		copy_headers Cookie
	}
	header @fig X-Robots-Tag "noindex, nofollow, noarchive"
	header @fig Cache-Control "private, no-store"
	redir /fig /fig/ 308

	# 未認証（401）はログイン画面へ。元の場所は next= で持ち回す。
	# ★ 2026-08-16 時点で apex に 401 を出す保護領域は /fig/ のみ。
	#   フォールバックは残す（costlab-auth は通常 303 を返す）。
	handle_errors {
		@unauth expression {err.status_code} == 401
		handle @unauth {
			redir * /__auth/login?next={uri} 303
		}
	}

	# 商品発掘（旧 hakkutsu・廃止済み）の記事は 2026-08-16 に公開終了（経緯は docs/notes.md）。
	# 検索結果・外部リンクを 404 にしないため、/pick 配下はトップへ恒久転送する。
	# ※ redir は handle より先に評価されるので、置き場所はどこでも /pick* を拾える。
	redir /pick* / permanent

	# 本屋さん（Web小説ランキング）。中身は inviteapp が描く。
	# 2026-08-14 に akiba.tokyo.jp/books から移した。パスは /books のまま。
	# ★ handle は書いた順で first-match。下の静的配信より前に置くこと。
	#   後ろに置くと /srv/costlab/books を探して 404 になる。
	@books path /books /books/
	handle @books {
		reverse_proxy inviteapp:8000
	}

	# 旧カテゴリまとめページ（gadget SSG 時代の URL）。独立静的サイトには置かないので、
	# トップへの転送だけ残す（検索結果・外部リンクを 404 にしない。/pick* と同じ扱い）。
	@oldcats path /ai.html /gadget.html /game.html /fashion.html /cosme.html
	redir @oldcats / permanent

	# サイト本体（sites/costlab の素の静的サイト。Actions の Site costlab deploy が
	# /var/www/costlab に配置する）。2026-08-16 に gadget の SSG から切り出した
	# （それまでは /srv/gadget-site を配信。経緯は docs/notes.md）。
	# キャッシュ方針: assets が安定名（内容ハッシュ無し）になったので長期キャッシュは張らない。
	# HTML も assets も短命＋必ず再検証（サイトが小さいので分ける利得が無い）。
	handle {
		root * /srv/costlab
		header Cache-Control "public, max-age=300, must-revalidate"
		file_server
	}
}

# sys-you.jp は 2026-09-03 に廃止（PortalX / sysyou 撤去）。
# DNS がまだ VPS に向いているあいだはブロックを残す（消すと証明書を出せず TLS エラーになる）。
# レコードを消したら、このブロックも消してよい。
# お試し場の旧ホスト（sandbox*.sys-you.jp）は上の 301 転送のまま残す。
sys-you.jp, www.sys-you.jp {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	respond "gone" 410
}
